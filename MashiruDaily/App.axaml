<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:MashiruDaily"
             xmlns:suki="https://github.com/kikipoulet/SukiUI"
             x:Class="MashiruDaily.App"
             RequestedThemeVariant="Default">
    <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Custom controls that extend SukiUI -->
                <ResourceInclude Source="/Controls/BottomNavigationBar/BottomNavigationBar.axaml" />
                <ResourceInclude Source="/Controls/BottomNavigationBar/BottomNavigationItem.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />
        <!-- SukiUI drives the look & feel; see https://kikipoulet.github.io/SukiUI/ -->
        <suki:SukiTheme Locale="zh-CN" ThemeColor="Blue" />
    </Application.Styles>
</Application>
