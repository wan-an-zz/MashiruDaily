<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:MashiruDaily"
             xmlns:suki="https://github.com/kikipoulet/SukiUI"
             x:Class="MashiruDaily.App"
             RequestedThemeVariant="Default">
    <!-- "Default" 主题变体跟随系统主题；"Dark" 或 "Light" 是其他可选值。 -->

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- 扩展 SukiUI 的自定义控件 -->
                <ResourceInclude Source="/Controls/BottomNavigationBar.axaml" />
                <ResourceInclude Source="/Controls/BottomNavigationItem.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />
        <!-- SukiUI 负责外观与风格；参见 https://kikipoulet.github.io/SukiUI/ -->
        <suki:SukiTheme Locale="zh-CN" ThemeColor="Blue" />
    </Application.Styles>
</Application>
