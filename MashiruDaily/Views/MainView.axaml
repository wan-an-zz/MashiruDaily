<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:assets="using:MashiruDaily.Assets"
             xmlns:controls="using:MashiruDaily.Controls"
             xmlns:models="using:MashiruDaily.Models"
             xmlns:suki="https://github.com/kikipoulet/SukiUI"
             xmlns:vm="using:MashiruDaily.ViewModels"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="800"
             x:Class="MashiruDaily.Views.MainView"
             x:DataType="vm:MainViewModel">

    <Border Background="{DynamicResource SukiStrongBackground}">
        <Grid RowDefinitions="*,Auto,Auto">

            <!-- Page content, resolved via ViewLocator, animated like SukiUI. -->
            <suki:SukiTransitioningContentControl Grid.Row="0"
                                                  Content="{Binding ActiveItem.Page}" />

            <controls:SyncStatusBar Grid.Row="1" />

            <!-- SukiUI-styled bottom navigation. -->
            <controls:BottomNavigationBar Grid.Row="2"
                                          ItemsSource="{Binding NavigationItems}"
                                          SelectedIndex="{Binding ActiveIndex, Mode=TwoWay}">
                <controls:BottomNavigationBar.ItemTemplate>
                    <DataTemplate x:DataType="models:NavigationItem">
                        <StackPanel Spacing="3"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                            <PathIcon Data="{Binding Icon}"
                                      Width="22" Height="22"
                                      HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding Header}"
                                       FontSize="11"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </DataTemplate>
                </controls:BottomNavigationBar.ItemTemplate>
            </controls:BottomNavigationBar>

        </Grid>
    </Border>
</UserControl>
